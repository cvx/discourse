export default class BundleTestGrowth extends Component {
  get rows() {
    return ROWS.filter((row) => row.weight > (this.args.minWeight ?? 0));
  }

  <template>
    <ul class="bundle-test-growth">
      {{#each this.rows as |row|}}
        <li data-id={{row.id}}>{{row.label}}</li>
      {{/each}}
    </ul>
  </template>
}
